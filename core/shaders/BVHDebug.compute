ComputeShader "Zarin/BVHDebug"
{
    Properties
    {
        _MaxDepth("Max Depth", Int) = 4
        _HeatmapIntensity("Heatmap Intensity", Float) = 1.0
    }

    GLSLPROGRAM
    #version 460 core
    layout(local_size_x = 256) in;

    layout(std430, binding = 0) restrict readonly buffer BVHNodes {
        float bvh_nodes[];
    };
    layout(std430, binding = 6) restrict readonly buffer NodeDepths {
        int node_depths[];
    };
    layout(std430, binding = 7) restrict writeonly buffer LineVerts {
        float line_verts[];
    };
    layout(std430, binding = 8) buffer LineCounter {
        uint line_count;
    };

    uniform int u_bvh_offset;
    uniform int u_node_count;
    uniform int u_max_depth;
    uniform float u_heatmap_intensity;
    uniform mat4 u_vp_matrix;
    uniform mat4 u_world_matrix;

    vec3 heatmap_palette(float t) {
        t = clamp(t, 0.0, 1.0);
        if (t < 0.25) return mix(vec3(0.0, 0.0, 1.0), vec3(0.0, 1.0, 1.0), t * 4.0);
        else if (t < 0.5) return mix(vec3(0.0, 1.0, 1.0), vec3(0.0, 1.0, 0.0), (t - 0.25) * 4.0);
        else if (t < 0.75) return mix(vec3(0.0, 1.0, 0.0), vec3(1.0, 1.0, 0.0), (t - 0.5) * 4.0);
        else return mix(vec3(1.0, 1.0, 0.0), vec3(1.0, 0.0, 0.0), (t - 0.75) * 4.0);
    }

    vec3 get_corner(vec3 bmin, vec3 bmax, int idx) {
        return vec3(
            (idx & 1) == 0 ? bmin.x : bmax.x,
            (idx & 2) == 0 ? bmin.y : bmax.y,
            (idx & 4) == 0 ? bmin.z : bmax.z
        );
    }

    void write_vert(uint idx, vec4 clip, vec3 color) {
        uint base = idx * 8u;
        line_verts[base + 0] = clip.x;
        line_verts[base + 1] = clip.y;
        line_verts[base + 2] = clip.z;
        line_verts[base + 3] = clip.w;
        line_verts[base + 4] = color.r;
        line_verts[base + 5] = color.g;
        line_verts[base + 6] = color.b;
        line_verts[base + 7] = 1.0;
    }

    void main() {
        int node_idx = int(gl_GlobalInvocationID.x);
        if (node_idx >= u_node_count) return;
        int abs_idx = u_bvh_offset + node_idx;
        int depth = node_depths[node_idx];
        if (depth > u_max_depth) return;
        int base = abs_idx * 8;
        vec3 bmin = vec3(bvh_nodes[base], bvh_nodes[base + 1], bvh_nodes[base + 2]);
        vec3 bmax = vec3(bvh_nodes[base + 3], bvh_nodes[base + 4], bvh_nodes[base + 5]);
        int left_or_start = int(bvh_nodes[base + 6]);
        int right_or_count = int(bvh_nodes[base + 7]);
        bool is_leaf = right_or_count < 0;
        int tri_cnt = is_leaf ? (-right_or_count - 1) : 0;
        float depth_t = (u_max_depth > 0) ? float(depth) / float(u_max_depth) : 0.0;
        float tri_t = is_leaf ? clamp(float(tri_cnt) / 32.0, 0.0, 1.0) : 0.0;
        float cost = depth_t * 0.7 + tri_t * 0.3;
        cost = clamp(cost * max(u_heatmap_intensity, 0.1), 0.0, 1.0);
        vec3 color = heatmap_palette(cost);
        vec3 corners[8];
        for (int i = 0; i < 8; i++) {
            corners[i] = get_corner(bmin, bmax, i);
        }
        int edges[24] = int[24](
            0,1, 1,2, 2,3, 3,0,
            4,5, 5,6, 6,7, 7,4,
            0,4, 1,5, 2,6, 3,7
        );
        uint vbase = atomicAdd(line_count, 24u);
        for (int e = 0; e < 24; e += 2) {
            vec3 a = corners[edges[e]];
            vec3 b = corners[edges[e + 1]];
            vec4 ca = u_vp_matrix * u_world_matrix * vec4(a, 1.0);
            vec4 cb = u_vp_matrix * u_world_matrix * vec4(b, 1.0);
            write_vert(vbase + uint(e), ca, color);
            write_vert(vbase + uint(e + 1), cb, color);
        }
    }
    ENDGLSL
}
