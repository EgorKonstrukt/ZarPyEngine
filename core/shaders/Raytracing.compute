ComputeShader "Zarin/Raytracing"
{
    Properties
    {
        _MaxBounces("Max Bounces", Int) = 1
        _SamplesPerPixel("Samples Per Pixel", Int) = 1
        _ResolutionScale("Resolution Scale", Float) = 1.0
        _Accumulate("Accumulate Frames", Int) = 0
    }

    GLSLPROGRAM
    #version 460 core
    layout(local_size_x = 8, local_size_y = 8) in;

    #define MAX_INSTANCES 256
    #define MAX_LIGHTS 8
    #define INV_PI 0.31830988618
    #define EPS 1e-6

    layout(std430, binding = 0) restrict readonly buffer BVHNodes {
        float bvh_nodes[];
    };
    layout(std430, binding = 1) restrict readonly buffer Vertices {
        float vert_data[];
    };
    layout(std430, binding = 2) restrict readonly buffer Indices {
        uint idx_data[];
    };
    layout(std430, binding = 3) restrict readonly buffer Materials {
        float mat_data[];
    };
    layout(std430, binding = 4) restrict readonly buffer Instances {
        float inst_data[];
    };
    layout(std430, binding = 5) restrict readonly buffer Lights {
        float light_data[];
    };
    layout(rgba32f, binding = 0) uniform image2D output_image;
    layout(rgba32f, binding = 1) uniform image2D emissive_image;

    uniform vec3 u_camera_pos;
    uniform mat4 u_inv_view_proj;
    uniform int u_screen_width;
    uniform int u_screen_height;
    uniform int u_instance_count;
    uniform int u_light_count;
    uniform int u_max_bounces;
    uniform int u_accum_frame;
    uniform int u_frame;
    uniform int u_accumulate;
    uniform int u_samples_per_pixel;
    uniform sampler2D u_sky_env;
    uniform sampler2DArray u_albedo_array;
    uniform int u_albedo_tex_count;

    const int MAX_ALBEDO_LAYERS = 32;

    float ray_aabb_min(vec3 o, vec3 inv_d, vec3 bmin, vec3 bmax) {
        vec3 t1 = (bmin - o) * inv_d;
        vec3 t2 = (bmax - o) * inv_d;
        vec3 tmin_v = min(t1, t2);
        vec3 tmax_v = max(t1, t2);
        float tmin = max(max(tmin_v.x, tmin_v.y), tmin_v.z);
        float tmax = min(min(tmax_v.x, tmax_v.y), tmax_v.z);
        return (tmin > tmax || tmax <= 0.0) ? -1.0 : max(tmin, 0.0);
    }

    vec3 fresnel_schlick(float cos_theta, vec3 F0) {
        return F0 + (1.0 - F0) * pow(1.0 - cos_theta, 5.0);
    }

    float distribution_ggx(float NdotH, float roughness) {
        float a = roughness * roughness;
        float a2 = a * a;
        float denom = NdotH * NdotH * (a2 - 1.0) + 1.0;
        return a2 * INV_PI / (denom * denom);
    }

    float geometry_smith(float NdotV, float NdotL, float roughness) {
        float k = (roughness + 1.0);
        k = k * k * 0.125;
        float g1 = NdotV / (NdotV * (1.0 - k) + k);
        float g2 = NdotL / (NdotL * (1.0 - k) + k);
        return g1 * g2;
    }

    vec3 sample_sky(vec3 dir) {
        float u = 0.5 + atan(dir.z, dir.x) * 0.15915494;
        float v = 0.5 - asin(clamp(dir.y, -1.0, 1.0)) * 0.31830988;
        return texture(u_sky_env, vec2(u, v)).rgb;
    }

    float intersect_bvh(vec3 ro, vec3 rd, vec3 inv_d, int bvh_offset, int idx_offset,
                        inout vec3 hit_pos, inout vec3 hit_N, inout vec2 hit_uv) {
        if (bvh_offset < 0) return 1e30;
        int stack_n[64];
        float stack_t[64];
        int sp = 0;
        stack_n[sp] = bvh_offset;
        stack_t[sp] = 0.0;
        sp++;
        float best_t = 1e30;

        while (sp > 0) {
            sp--;
            int ni = stack_n[sp];
            float ni_t = stack_t[sp];
            if (ni_t >= best_t) continue;

            int base = ni * 8;
            int left_or_start = int(bvh_nodes[base + 6]);
            int right_or_count = int(bvh_nodes[base + 7]);
            if (right_or_count >= 0) {
                int lbase = left_or_start * 8;
                int rbase = right_or_count * 8;
                float lt = ray_aabb_min(ro, inv_d, vec3(bvh_nodes[lbase], bvh_nodes[lbase + 1], bvh_nodes[lbase + 2]),
                                        vec3(bvh_nodes[lbase + 3], bvh_nodes[lbase + 4], bvh_nodes[lbase + 5]));
                float rt = ray_aabb_min(ro, inv_d, vec3(bvh_nodes[rbase], bvh_nodes[rbase + 1], bvh_nodes[rbase + 2]),
                                        vec3(bvh_nodes[rbase + 3], bvh_nodes[rbase + 4], bvh_nodes[rbase + 5]));
                bool lhit = lt >= 0.0 && lt < best_t;
                bool rhit = rt >= 0.0 && rt < best_t;
                if (lhit && rhit) {
                    if (lt < rt) {
                        stack_n[sp] = right_or_count; stack_t[sp] = rt; sp++;
                        stack_n[sp] = left_or_start; stack_t[sp] = lt; sp++;
                    } else {
                        stack_n[sp] = left_or_start; stack_t[sp] = lt; sp++;
                        stack_n[sp] = right_or_count; stack_t[sp] = rt; sp++;
                    }
                } else if (lhit) {
                    stack_n[sp] = left_or_start; stack_t[sp] = lt; sp++;
                } else if (rhit) {
                    stack_n[sp] = right_or_count; stack_t[sp] = rt; sp++;
                }
                continue;
            }

            int tri_end = left_or_start + (-right_or_count - 1);
            for (int ti = left_or_start; ti < tri_end; ti++) {
                int ib = int((idx_offset + ti)) * 3;
                uint i0 = idx_data[ib];
                uint i1 = idx_data[ib + 1];
                uint i2 = idx_data[ib + 2];
                int i0i = int(i0) * 8;
                int i1i = int(i1) * 8;
                int i2i = int(i2) * 8;

                vec3 v0 = vec3(vert_data[i0i], vert_data[i0i + 1], vert_data[i0i + 2]);
                vec3 v1 = vec3(vert_data[i1i], vert_data[i1i + 1], vert_data[i1i + 2]);
                vec3 v2 = vec3(vert_data[i2i], vert_data[i2i + 1], vert_data[i2i + 2]);

                vec3 e1 = v1 - v0;
                vec3 e2 = v2 - v0;
                vec3 p = cross(rd, e2);
                float det = dot(e1, p);
                if (abs(det) < 1e-12) continue;

                float inv_det = 1.0 / det;
                vec3 t_vec = ro - v0;
                float u = dot(t_vec, p) * inv_det;
                if (u < 0.0 || u > 1.0) continue;

                vec3 q = cross(t_vec, e1);
                float v = dot(rd, q) * inv_det;
                if (v < 0.0 || (u + v) > 1.0) continue;

                float tt = dot(e2, q) * inv_det;
                if (tt <= 0.0 || tt >= best_t) continue;

                best_t = tt;
                hit_pos = ro + tt * rd;
                vec3 n0 = vec3(vert_data[i0i + 3], vert_data[i0i + 4], vert_data[i0i + 5]);
                vec3 n1 = vec3(vert_data[i1i + 3], vert_data[i1i + 4], vert_data[i1i + 5]);
                vec3 n2 = vec3(vert_data[i2i + 3], vert_data[i2i + 4], vert_data[i2i + 5]);
                float w = 1.0 - u - v;
                hit_N = normalize(n0 * w + n1 * u + n2 * v);
                vec2 uv0 = vec2(vert_data[i0i + 6], vert_data[i0i + 7]);
                vec2 uv1 = vec2(vert_data[i1i + 6], vert_data[i1i + 7]);
                vec2 uv2 = vec2(vert_data[i2i + 6], vert_data[i2i + 7]);
                hit_uv = uv0 * w + uv1 * u + uv2 * v;
            }
        }
        return best_t;
    }

    float trace_shadow(vec3 ro, vec3 rd, float max_dist) {
        vec3 inv_rd = 1.0 / rd;
        float visibility = 1.0;
        for (int inst = 0; inst < u_instance_count && inst < MAX_INSTANCES; inst++) {
            int ib = inst * 46;
            vec3 wbmin = vec3(inst_data[ib + 38], inst_data[ib + 39], inst_data[ib + 40]);
            vec3 wbmax = vec3(inst_data[ib + 41], inst_data[ib + 42], inst_data[ib + 43]);
            float aabb_t = ray_aabb_min(ro, inv_rd, wbmin, wbmax);
            if (aabb_t < 0.0 || aabb_t >= max_dist) continue;

            int bvh_offset = int(inst_data[ib + 32]);
            int idx_off = int(inst_data[ib + 34]);
            int mat_idx = int(inst_data[ib + 35]);

            mat4 inv_wm = mat4(
                vec4(inst_data[ib+16], inst_data[ib+17], inst_data[ib+18], inst_data[ib+19]),
                vec4(inst_data[ib+20], inst_data[ib+21], inst_data[ib+22], inst_data[ib+23]),
                vec4(inst_data[ib+24], inst_data[ib+25], inst_data[ib+26], inst_data[ib+27]),
                vec4(inst_data[ib+28], inst_data[ib+29], inst_data[ib+30], inst_data[ib+31])
            );

            vec3 lro = (inv_wm * vec4(ro, 1.0)).xyz;
            vec3 lrd = normalize((inv_wm * vec4(rd, 0.0)).xyz);
            vec3 inv_lrd = 1.0 / lrd;

            if (bvh_offset < 0) continue;
            int stack_n[32];
            float stack_t[32];
            int sp = 0;
            stack_n[sp] = bvh_offset;
            stack_t[sp] = 0.0;
            sp++;
            while (sp > 0) {
                sp--;
                int ni = stack_n[sp];
                float ni_t = stack_t[sp];
                if (ni_t >= max_dist) continue;

                int base = ni * 8;
                int left_or_start = int(bvh_nodes[base + 6]);
                int right_or_count = int(bvh_nodes[base + 7]);
                if (right_or_count >= 0) {
                    int lbase = left_or_start * 8;
                    int rbase = right_or_count * 8;
                    float lt = ray_aabb_min(lro, inv_lrd, vec3(bvh_nodes[lbase], bvh_nodes[lbase + 1], bvh_nodes[lbase + 2]),
                                            vec3(bvh_nodes[lbase + 3], bvh_nodes[lbase + 4], bvh_nodes[lbase + 5]));
                    float rt = ray_aabb_min(lro, inv_lrd, vec3(bvh_nodes[rbase], bvh_nodes[rbase + 1], bvh_nodes[rbase + 2]),
                                            vec3(bvh_nodes[rbase + 3], bvh_nodes[rbase + 4], bvh_nodes[rbase + 5]));
                    if (lt >= 0.0 && lt < max_dist) { stack_n[sp] = left_or_start; stack_t[sp] = lt; sp++; }
                    if (rt >= 0.0 && rt < max_dist) { stack_n[sp] = right_or_count; stack_t[sp] = rt; sp++; }
                    continue;
                }

                int tri_end = left_or_start + (-right_or_count - 1);
                for (int ti = left_or_start; ti < tri_end; ti++) {
                    int idx_b = int((idx_off + ti)) * 3;
                    uint i0 = idx_data[idx_b];
                    uint i1 = idx_data[idx_b + 1];
                    uint i2 = idx_data[idx_b + 2];
                    int i0i = int(i0) * 8;
                    int i1i = int(i1) * 8;
                    int i2i = int(i2) * 8;

                    vec3 v0 = vec3(vert_data[i0i], vert_data[i0i + 1], vert_data[i0i + 2]);
                    vec3 v1 = vec3(vert_data[i1i], vert_data[i1i + 1], vert_data[i1i + 2]);
                    vec3 v2 = vec3(vert_data[i2i], vert_data[i2i + 1], vert_data[i2i + 2]);

                    vec3 e1 = v1 - v0;
                    vec3 e2 = v2 - v0;
                    vec3 p = cross(lrd, e2);
                    float det = dot(e1, p);
                    if (abs(det) < 1e-12) continue;
                    float inv_det = 1.0 / det;
                    vec3 t_vec = lro - v0;
                    float u = dot(t_vec, p) * inv_det;
                    if (u < 0.0 || u > 1.0) continue;
                    vec3 q = cross(t_vec, e1);
                    float v = dot(lrd, q) * inv_det;
                    if (v < 0.0 || (u + v) > 1.0) continue;
                    float tt = dot(e2, q) * inv_det;
                    if (tt > 0.0 && tt < max_dist) {
                        int mb = mat_idx * 20;
                        float shadow_alpha = mat_data[mb + 11];
                        float shadow_trans = mat_data[mb + 12];
                        visibility *= max(0.0, 1.0 - shadow_alpha * (1.0 - shadow_trans));
                        if (visibility < 0.01) return 0.0;
                        break;
                    }
                }
            }
        }
        return visibility;
    }

    float intersect_scene_internal(vec3 ro, vec3 rd, vec3 inv_rd,
                          inout vec3 hit_pos, inout vec3 hit_N, inout vec2 hit_uv,
                          inout int hit_mat, inout int hit_inst,
                          int scan_inst, bool find_backface) {
        float best_t = 1e30;
        vec3 best_pos = vec3(0.0);
        vec3 best_N = vec3(0.0, 1.0, 0.0);
        vec2 best_uv = vec2(0.0);
        int best_mat = -1;
        int best_inst = -1;

        for (int inst = 0; inst < u_instance_count && inst < MAX_INSTANCES; inst++) {
            if (scan_inst >= 0 && inst != scan_inst) continue;
            int ib = inst * 46;
            vec3 wbmin = vec3(inst_data[ib + 38], inst_data[ib + 39], inst_data[ib + 40]);
            vec3 wbmax = vec3(inst_data[ib + 41], inst_data[ib + 42], inst_data[ib + 43]);
            float aabb_t = ray_aabb_min(ro, inv_rd, wbmin, wbmax);
            if (aabb_t < 0.0 || aabb_t >= best_t) continue;

            int bvh_offset = int(inst_data[ib + 32]);
            int idx_off = int(inst_data[ib + 34]);
            int mat_idx = int(inst_data[ib + 35]);

            mat4 inv_wm = mat4(
                vec4(inst_data[ib+16], inst_data[ib+17], inst_data[ib+18], inst_data[ib+19]),
                vec4(inst_data[ib+20], inst_data[ib+21], inst_data[ib+22], inst_data[ib+23]),
                vec4(inst_data[ib+24], inst_data[ib+25], inst_data[ib+26], inst_data[ib+27]),
                vec4(inst_data[ib+28], inst_data[ib+29], inst_data[ib+30], inst_data[ib+31])
            );

            vec3 lro = (inv_wm * vec4(ro, 1.0)).xyz;
            vec3 lrd = normalize((inv_wm * vec4(rd, 0.0)).xyz);
            vec3 inv_lrd = 1.0 / lrd;

            vec3 lpos, lN;
            vec2 luv;
            float tt = intersect_bvh(lro, lrd, inv_lrd, bvh_offset, idx_off, lpos, lN, luv);
            if (tt < best_t) {
                best_t = tt;
                best_mat = mat_idx;
                best_inst = inst;
                mat4 wm = mat4(
                    vec4(inst_data[ib], inst_data[ib+1], inst_data[ib+2], inst_data[ib+3]),
                    vec4(inst_data[ib+4], inst_data[ib+5], inst_data[ib+6], inst_data[ib+7]),
                    vec4(inst_data[ib+8], inst_data[ib+9], inst_data[ib+10], inst_data[ib+11]),
                    vec4(inst_data[ib+12], inst_data[ib+13], inst_data[ib+14], inst_data[ib+15])
                );
                best_pos = (wm * vec4(lpos, 1.0)).xyz;
                vec3 wN = normalize(transpose(mat3(inv_wm)) * lN);
                if (find_backface) {
                    best_N = (dot(wN, rd) > 0.0) ? wN : -wN;
                } else {
                    best_N = (dot(wN, rd) > 0.0) ? -wN : wN;
                }
                best_uv = luv;
            }
        }

        hit_pos = best_pos;
        hit_N = best_N;
        hit_uv = best_uv;
        hit_mat = best_mat;
        hit_inst = best_inst;
        return best_t;
    }

    float intersect_scene(vec3 ro, vec3 rd, vec3 inv_rd,
                          inout vec3 hit_pos, inout vec3 hit_N, inout vec2 hit_uv,
                          inout int hit_mat, inout int hit_inst) {
        return intersect_scene_internal(ro, rd, inv_rd, hit_pos, hit_N, hit_uv, hit_mat, hit_inst, -1, false);
    }

    float intersect_exit(int inst, vec3 ro, vec3 rd, vec3 inv_rd,
                         inout vec3 hit_pos, inout vec3 hit_N, inout vec2 hit_uv,
                         inout int hit_mat) {
        int dummy_inst;
        return intersect_scene_internal(ro, rd, inv_rd, hit_pos, hit_N, hit_uv, hit_mat, dummy_inst, inst, true);
    }

    vec3 direct_light(vec3 pos, vec3 N, vec3 V, float NdotV,
                      vec3 albedo, float roughness, float metallic, vec3 F0) {
        vec3 contrib = vec3(0.0);
        for (int li = 0; li < u_light_count && li < MAX_LIGHTS; li++) {
            int base = li * 14;
            int lt = int(light_data[base]);
            vec3 lpos = vec3(light_data[base+1], light_data[base+2], light_data[base+3]);
            vec3 ldir = vec3(light_data[base+4], light_data[base+5], light_data[base+6]);
            vec3 lcol = vec3(light_data[base+7], light_data[base+8], light_data[base+9]);
            float lint = light_data[base+10];
            float lrange = light_data[base+11];
            float lspot_cos = light_data[base+12];
            float linner_cos = light_data[base+13];

            vec3 light_dir;
            float attenuation = 1.0;
            if (lt == 0) {
                light_dir = normalize(-ldir);
            } else {
                vec3 to_light = lpos - pos;
                float dist = length(to_light);
                light_dir = to_light / dist;
                float att = 1.0 - dist / lrange;
                if (att <= 0.0) continue;
                attenuation = att * att;
                if (lt == 2) {
                    float theta = dot(light_dir, normalize(-ldir));
                    attenuation *= clamp((theta - linner_cos) / (lspot_cos - linner_cos), 0.0, 1.0);
                    if (attenuation < EPS) continue;
                }
            }

            float NdotL = dot(N, light_dir);
            if (NdotL <= 0.0) continue;

            float shadow_dist = (lt == 0) ? 1e20 : length(lpos - pos);
            vec3 shadow_ro = pos + N * 0.002;
            float shadow = trace_shadow(shadow_ro, light_dir, shadow_dist);
            if (shadow < 0.01) continue;

            vec3 H = normalize(V + light_dir);
            float NdotH = dot(N, H);
            float HdotV = dot(H, V);
            vec3 radiance = lcol * lint;
            vec3 F = fresnel_schlick(max(HdotV, 0.0), F0);
            float NDF = distribution_ggx(NdotH, roughness);
            float G = geometry_smith(NdotV, NdotL, roughness);
            vec3 kS = F;
            vec3 kD = (1.0 - kS) * (1.0 - metallic);
            vec3 specular = (NDF * G * F) / max(4.0 * NdotV * NdotL, EPS);
            vec3 diffuse = kD * albedo * INV_PI;
            contrib += (diffuse + specular) * radiance * NdotL * attenuation * shadow;
        }
        return contrib;
    }

    vec3 g_emissive = vec3(0.0);

    float _hash(vec2 p) {
        vec3 p3 = fract(vec3(p.xyx) * vec3(0.1031, 0.1030, 0.0973));
        p3 += dot(p3, p3.yzx + 33.33);
        return fract((p3.x + p3.y) * p3.z);
    }

    vec3 _scatter_dir(vec3 refl_dir, vec3 N, float roughness, vec2 pix, float bounce_idx, float fi) {
        if (roughness < 0.01) return refl_dir;
        float ang = roughness * 1.5707963;
        float h1 = _hash(pix + vec2(bounce_idx * 17.3 + fi * 127.1, bounce_idx * 31.7 + fi * 231.7));
        float h2 = _hash(pix + vec2(bounce_idx * 53.1 + fi * 41.1, bounce_idx * 7.9 + fi * 17.9));
        float theta = ang * h1;
        float phi = 6.2831853 * h2;
        vec3 up = abs(refl_dir.y) < 0.99 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
        vec3 tangent = normalize(cross(up, refl_dir));
        vec3 bitangent = cross(refl_dir, tangent);
        vec3 local = vec3(sin(theta) * cos(phi), cos(theta), sin(theta) * sin(phi));
        return tangent * local.x + refl_dir * local.y + bitangent * local.z;
    }

    vec4 sample_albedo_tex(vec2 uv, int tex_layer) {
        if (u_albedo_tex_count <= 0 || tex_layer < 0) return vec4(1.0);
        float layer = clamp(float(tex_layer), 0.0, float(MAX_ALBEDO_LAYERS - 1));
        return texture(u_albedo_array, vec3(fract(uv), layer));
    }

    vec3 trace_ray(vec3 ro, vec3 rd, ivec2 pix, float fi) {
        vec3 accumulated = vec3(0.0);
        vec3 throughput = vec3(1.0);
        g_emissive = vec3(0.0);
        int medium_inst = -1;
        float cur_ior = 1.0;
        vec3 entry_pos = vec3(0.0);
        vec3 entry_albedo = vec3(1.0);

        int bounce = 0;
        int max_iters = (u_max_bounces + 1) * 6 + 16;

        for (int it = 0; it < max_iters; it++) {
            vec3 hit_pos, hit_N;
            vec2 hit_uv;
            int hit_mat;
            vec3 inv_rd = 1.0 / rd;
            float hit_t;
            int hit_inst;
            if (medium_inst >= 0) {
                hit_t = intersect_exit(medium_inst, ro, rd, inv_rd, hit_pos, hit_N, hit_uv, hit_mat);
            } else {
                hit_t = intersect_scene(ro, rd, inv_rd, hit_pos, hit_N, hit_uv, hit_mat, hit_inst);
            }

            if (hit_mat < 0) {
                accumulated += throughput * sample_sky(rd);
                break;
            }

            int mb = hit_mat * 20;
            vec4 albedo_rgba = vec4(mat_data[mb], mat_data[mb+1], mat_data[mb+2], mat_data[mb+11]);
            vec3 albedo = albedo_rgba.rgb;
            float alpha = albedo_rgba.a;
            float metallic = mat_data[mb+3];
            float smoothness = mat_data[mb+4];
            vec3 emission = vec3(mat_data[mb+5], mat_data[mb+6], mat_data[mb+7]);
            float em_intensity = mat_data[mb+8];
            int albedo_tex_layer = int(mat_data[mb+9]);
            float occlusion = mat_data[mb+10];
            float transmission = mat_data[mb+12];
            float ior = mat_data[mb+13];
            float roughness = max(1.0 - smoothness, 0.001);
            vec3 F0 = mix(vec3(0.04), albedo, metallic);

            vec4 tex_albedo = sample_albedo_tex(hit_uv, albedo_tex_layer);
            albedo *= tex_albedo.rgb;
            alpha *= tex_albedo.a;

            if (medium_inst >= 0) {
                float path_len = length(hit_pos - entry_pos);
                vec3 absorption = exp(-path_len * max(vec3(0.01), (vec3(1.0) - entry_albedo)) * 3.0);
                throughput *= absorption;
                if (max(max(throughput.x, throughput.y), throughput.z) < 0.005) break;
                float eta = cur_ior;
                vec3 refract_dir = refract(rd, -hit_N, eta);
                if (length(refract_dir) < 0.001) {
                    rd = reflect(rd, hit_N);
                    ro = hit_pos - hit_N * 0.002;
                    entry_pos = hit_pos;
                } else {
                    rd = normalize(refract_dir);
                    ro = hit_pos + hit_N * 0.002;
                    medium_inst = -1;
                    cur_ior = 1.0;
                }
                continue;
            }

            if (em_intensity > EPS) {
                vec3 em = throughput * emission * em_intensity;
                accumulated += em;
                g_emissive += em;
            }

            vec3 V = -rd;
            float NdotV = max(dot(hit_N, V), 0.0);

            vec3 direct = direct_light(hit_pos, hit_N, V, NdotV, albedo, roughness, metallic, F0) * occlusion;
            accumulated += throughput * direct;

            if (bounce >= u_max_bounces) break;

            float spec_w = mix(0.04, 1.0, smoothness);
            spec_w = mix(spec_w, 1.0, metallic);
            float diff_w = (1.0 - metallic) * (1.0 - spec_w);

            accumulated += throughput * diff_w * albedo * sample_sky(hit_N) * occlusion;

            float transmittance = 1.0 - alpha * (1.0 - transmission);
            float h = _hash(pix + vec2(fi * 91.7 + float(bounce) * 13.1, fi * 53.3 + float(bounce) * 27.7));
            if (transmittance > 0.02) {
                float fresnel = pow(1.0 - NdotV, 5.0);
                float refract_prob = transmittance * (1.0 - fresnel);
                if (h < refract_prob) {
                    float eta = 1.0 / ior;
                    vec3 refract_dir = refract(rd, hit_N, eta);
                    if (length(refract_dir) < 0.001) {
                        vec3 refl_dir = _scatter_dir(reflect(rd, hit_N), hit_N, roughness, pix, float(bounce), fi);
                        ro = hit_pos + hit_N * 0.002;
                        rd = normalize(refl_dir);
                        throughput *= mix(vec3(spec_w), albedo * spec_w, metallic);
                    } else {
                        refract_dir = _scatter_dir(refract_dir, hit_N, roughness, pix, float(bounce), fi);
                        ro = hit_pos - hit_N * 0.002;
                        rd = normalize(refract_dir);
                        medium_inst = hit_inst;
                        cur_ior = ior;
                        entry_pos = hit_pos;
                        entry_albedo = albedo;
                        if (max(max(throughput.x, throughput.y), throughput.z) < 0.005) break;
                        continue;
                    }
                } else {
                    vec3 reflect_dir = _scatter_dir(reflect(rd, hit_N), hit_N, roughness, pix, float(bounce), fi);
                    ro = hit_pos + hit_N * 0.002;
                    rd = normalize(reflect_dir);
                    throughput *= mix(vec3(spec_w), albedo * spec_w, metallic);
                }
            } else {
                vec3 reflect_dir = _scatter_dir(reflect(rd, hit_N), hit_N, roughness, pix, float(bounce), fi);
                ro = hit_pos + hit_N * 0.002;
                rd = normalize(reflect_dir);
                throughput *= mix(vec3(spec_w), albedo * spec_w, metallic);
            }

            if (max(max(throughput.x, throughput.y), throughput.z) < 0.005) break;
            bounce++;
        }
        return accumulated;
    }

    void main() {
        ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
        ivec2 screen_size = imageSize(output_image);
        if (pix.x >= screen_size.x || pix.y >= screen_size.y) return;

        vec3 ray_o = u_camera_pos;
        vec3 color = vec3(0.0);
        vec3 em_total = vec3(0.0);
        int spp = max(u_samples_per_pixel, 1);
        float inv_spp = 1.0 / float(spp);
        vec2 screen_dims = vec2(u_screen_width, u_screen_height);

        vec2 uv0 = (vec2(pix) + 0.5) / screen_dims;
        vec4 wn0 = u_inv_view_proj * vec4(uv0.x * 2.0 - 1.0, uv0.y * 2.0 - 1.0, 1.0, 1.0);
        vec3 base_dir = wn0.xyz / wn0.w - ray_o;
        vec4 wnx = u_inv_view_proj * vec4((uv0.x + 1.0 / screen_dims.x) * 2.0 - 1.0, uv0.y * 2.0 - 1.0, 1.0, 1.0);
        vec3 dx_dir = (wnx.xyz / wnx.w - ray_o) - base_dir;
        vec4 wny = u_inv_view_proj * vec4(uv0.x * 2.0 - 1.0, (uv0.y + 1.0 / screen_dims.y) * 2.0 - 1.0, 1.0, 1.0);
        vec3 dy_dir = (wny.xyz / wny.w - ray_o) - base_dir;

        for (int s = 0; s < spp; s++) {
            float fi = float(u_frame * spp + s);
            vec2 jitter = vec2(
                _hash(pix + vec2(fi * 13.7, fi * 29.3)) - 0.5,
                _hash(pix + vec2(fi * 41.1, fi * 7.9)) - 0.5
            );

            vec3 ray_d = normalize(base_dir + jitter.x * dx_dir + jitter.y * dy_dir);

            color += trace_ray(ray_o, ray_d, pix, fi) * inv_spp;
            em_total += g_emissive * inv_spp;
        }

        if (u_accumulate == 0 || u_accum_frame <= 1) {
            imageStore(output_image, pix, vec4(color, 1.0));
            imageStore(emissive_image, pix, vec4(em_total, 1.0));
        } else {
            vec4 prev = imageLoad(output_image, pix);
            float t = float(u_accum_frame);
            color = prev.rgb * ((t - 1.0) / t) + color / t;
            imageStore(output_image, pix, vec4(color, 1.0));
            vec4 prev_em = imageLoad(emissive_image, pix);
            em_total = prev_em.rgb * ((t - 1.0) / t) + em_total / t;
            imageStore(emissive_image, pix, vec4(em_total, 1.0));
        }
    }
    ENDGLSL
}
