//
// Radiance Cascades Global Illumination
// Based on the paper by Alexander Sannikov (Grinding Gear Games)
// https://github.com/Raikiri/RadianceCascadesPaper

ComputeShader "Zarin/RadianceCascades"
{
    Properties
    {
        _StepSize("Step Size", Float) = 0.5
        _DepthThreshold("Depth Threshold", Float) = 0.005
        _NumCascades("Num Cascades", Int) = 7
        _Intensity("GI Intensity", Float) = 1.0
    }

    GLSLPROGRAM
    #version 460 core
    layout(local_size_x = 8, local_size_y = 8) in;

    #define TAU 6.28318530718
    #define PI 3.14159265359
    #define INV_PI 0.31830988618
    #define EPS 1e-6

    #define MODE_POPULATE 0
    #define MODE_RECONSTRUCT 1
    #define MODE_DEBUG_TEST 2

    layout(binding = 0) uniform sampler2D u_depth_tex;
    layout(binding = 1) uniform sampler2D u_color_tex;

    uniform vec2 u_screen_size;
    uniform mat4 u_inv_view_proj;
    uniform vec3 u_camera_right;
    uniform vec3 u_camera_forward;
    uniform int u_num_cascades;
    uniform float u_step_size;
    uniform float u_depth_threshold;
    uniform float u_intensity;
    uniform int u_mode;

    layout(rgba32f, binding = 2) uniform image2D u_cascade_atlas;
    layout(rgba32f, binding = 3) uniform image2D u_gi_output;

    vec3 world_from_depth(vec2 uv, float depth) {
        vec4 ndc = vec4(uv * 2.0 - 1.0, depth * 2.0 - 1.0, 1.0);
        vec4 world = u_inv_view_proj * ndc;
        return world.xyz / world.w;
    }

    vec3 compute_normal(vec2 uv) {
        vec2 texel = 1.0 / u_screen_size;
        float d = texture(u_depth_tex, uv).r;
        float dpx = texture(u_depth_tex, uv + vec2(texel.x, 0.0)).r;
        float dpy = texture(u_depth_tex, uv + vec2(0.0, texel.y)).r;

        vec3 P = world_from_depth(uv, d);
        vec3 Ppx = world_from_depth(uv + vec2(texel.x, 0.0), dpx);
        vec3 Ppy = world_from_depth(uv + vec2(0.0, texel.y), dpy);

        vec3 dx = Ppx - P;
        vec3 dy = Ppy - P;
        vec3 n = normalize(cross(dx, dy));
        if (dot(n, u_camera_forward) > 0.0) n = -n;
        return n;
    }

    int cascade_offset(int c, int screen_h) {
        int off = 0;
        for (int i = 0; i < c; i++) {
            off += screen_h >> (i + 1);
        }
        return off;
    }

    int cascade_height(int c, int screen_h) {
        return screen_h >> (c + 1);
    }

    vec3 dir_from_angle(float angle, vec3 N) {
        vec3 T = abs(dot(u_camera_right, N)) < 0.99
            ? normalize(u_camera_right - dot(u_camera_right, N) * N)
            : normalize(u_camera_forward - dot(u_camera_forward, N) * N);
        vec3 B = cross(N, T);
        return normalize(cos(angle) * T + sin(angle) * B + N);
    }

    void populate_probe(int cascade_idx, int probe_px, int probe_py, int direction, ivec2 atlas_pos) {
        int spacing = 1 << (cascade_idx + 1);
        int num_dirs = spacing;

        float angle = (float(direction) + 0.5) / float(num_dirs) * TAU;
        vec2 dir_2d = vec2(cos(angle), sin(angle));

        vec2 probe_uv = (vec2(probe_px * spacing + spacing / 2, probe_py * spacing + spacing / 2) + 0.5) / u_screen_size;
        float probe_depth = texture(u_depth_tex, probe_uv).r;

        float min_range = float(spacing) * 0.25;
        float max_range = float(spacing) * 4.0;

        vec3 radiance = vec3(0.0);
        float beta = 1.0;
        float t = min_range;

        int max_steps = int((max_range - min_range) / u_step_size) + 1;
        max_steps = min(max_steps, 256);

        for (int s = 0; s < max_steps && beta > EPS; s++) {
            t = min_range + float(s) * u_step_size;
            vec2 sample_uv = probe_uv + dir_2d * (t / u_screen_size);
            if (sample_uv.x < 0.0 || sample_uv.x > 1.0 ||
                sample_uv.y < 0.0 || sample_uv.y > 1.0) break;

            float sample_depth = texture(u_depth_tex, sample_uv).r;
            if (sample_depth >= 1.0 - EPS) continue;

            float dist = (t - min_range) / (max_range - min_range);
            float weight = 1.0 - dist;
            if (weight <= 0.0) break;

            vec3 hit_color = texture(u_color_tex, sample_uv).rgb;
            radiance += beta * weight * hit_color;
            beta *= 0.85;
        }

        imageStore(u_cascade_atlas, atlas_pos, vec4(radiance, 1.0 - beta));
    }

    void reconstruct() {
        ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
        ivec2 screen = imageSize(u_gi_output);
        if (pixel.x >= screen.x || pixel.y >= screen.y) return;

        vec2 uv = (vec2(pixel) + 0.5) / u_screen_size;
        float depth = texture(u_depth_tex, uv).r;
        if (depth >= 1.0 - EPS) {
            imageStore(u_gi_output, pixel, vec4(0.0, 0.0, 0.0, 0.0));
            return;
        }

        vec3 N = compute_normal(uv);

        vec3 indirect = vec3(0.0);
        float remaining = 1.0;

        int screen_h = int(u_screen_size.y);
        for (int c = 0; c < u_num_cascades; c++) {
            int spacing = 1 << (c + 1);
            int num_dirs = spacing;
            int offset_y = cascade_offset(c, screen_h);
            int height = cascade_height(c, screen_h);

            int px = pixel.x / spacing;
            int py = pixel.y / spacing;

            vec3 cascade_L = vec3(0.0);
            float cascade_beta = 0.0;
            float norm = 0.0;

            for (int dy = 0; dy <= 1; dy++) {
                for (int dx = 0; dx <= 1; dx++) {
                    int npx = px + dx;
                    int npy = py + dy;

                    vec2 probe_center = (vec2(npx * spacing + spacing / 2, npy * spacing + spacing / 2) + 0.5) / u_screen_size;
                    vec2 diff_px = (uv - probe_center) * u_screen_size;
                    float w = max(1.0 - length(diff_px) / float(spacing), 0.0);
                    if (w <= 0.0) continue;

                    float dir_weight = 0.0;
                    vec3 dir_L = vec3(0.0);
                    float dir_beta = 0.0;

                    for (int d = 0; d < num_dirs; d++) {
                        int tx = npx * spacing + d;
                        int ty = offset_y + npy;
                        if (tx >= screen.x || ty >= offset_y + height) continue;

                        vec4 data = imageLoad(u_cascade_atlas, ivec2(tx, ty));
                        float angle = (float(d) + 0.5) / float(num_dirs) * TAU;
                        vec3 dir = dir_from_angle(angle, N);
                        float NdotL = max(dot(N, dir), 0.0);
                        if (NdotL < EPS) continue;

                        dir_L += NdotL * data.rgb;
                        dir_beta += NdotL * data.a;
                        dir_weight += NdotL;
                    }

                    if (dir_weight > EPS) {
                        cascade_L += w * dir_L / dir_weight;
                        cascade_beta += w * dir_beta / dir_weight;
                        norm += w;
                    }
                }
            }

            if (norm > EPS) {
                cascade_L /= norm;
                cascade_beta /= norm;

                indirect += remaining * cascade_L * (1.0 - cascade_beta);
                remaining *= cascade_beta;
            }
        }

        indirect *= INV_PI * u_intensity;
        indirect += 1e-10 * (u_camera_right + u_camera_forward);
        imageStore(u_gi_output, pixel, vec4(max(indirect, 0.0) + 1e-10 * u_depth_threshold, 1.0));
    }

    void populate() {
        ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
        ivec2 atlas_size = imageSize(u_cascade_atlas);
        if (pos.x >= atlas_size.x || pos.y >= atlas_size.y) return;

        int screen_h = int(u_screen_size.y);
        int cascade_idx = -1;
        int local_y = 0;
        int y_accum = 0;

        for (int i = 0; i < u_num_cascades; i++) {
            int h = cascade_height(i, screen_h);
            if (pos.y >= y_accum && pos.y < y_accum + h) {
                cascade_idx = i;
                local_y = pos.y - y_accum;
                break;
            }
            y_accum += h;
        }

        if (cascade_idx < 0) return;

        int spacing = 1 << (cascade_idx + 1);
        int num_dirs = spacing;
        int probe_px = pos.x / spacing;
        int probe_py = local_y;
        int direction = pos.x % spacing;

        if (direction >= num_dirs) return;

        populate_probe(cascade_idx, probe_px, probe_py, direction, pos);
    }

    void debug_test() {
        ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
        ivec2 screen = imageSize(u_gi_output);
        if (pixel.x >= screen.x || pixel.y >= screen.y) return;
        vec2 uv = (vec2(pixel) + 0.5) / u_screen_size;
        float d = texture(u_depth_tex, uv).r;
        vec3 color = vec3(uv.x, uv.y, 0.0);
        if (d >= 1.0 - EPS) color = vec3(1.0, 0.0, 0.0);
        imageStore(u_gi_output, pixel, vec4(color + 1e-10 * (u_camera_right + u_camera_forward + vec3(u_depth_threshold)), 1.0));
    }

    void debug_atlas() {
        ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
        ivec2 screen = imageSize(u_gi_output);
        if (pixel.x >= screen.x || pixel.y >= screen.y) return;
        vec4 data = imageLoad(u_cascade_atlas, ivec2(pixel.x, pixel.y));
        vec3 color = data.rgb * 0.5 + 0.25;
        imageStore(u_gi_output, pixel, vec4(color + 1e-10 * (u_camera_right + u_camera_forward + vec3(u_depth_threshold)), 1.0));
    }

    void debug_reconstruct() {
        ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
        ivec2 screen = imageSize(u_gi_output);
        if (pixel.x >= screen.x || pixel.y >= screen.y) return;
        vec2 uv = (vec2(pixel) + 0.5) / u_screen_size;
        float depth = texture(u_depth_tex, uv).r;
        if (depth >= 1.0 - EPS) {
            imageStore(u_gi_output, pixel, vec4(0.0, 0.0, 0.0, 0.0));
            return;
        }
        vec3 N = compute_normal(uv);
        int screen_h = int(u_screen_size.y);
        for (int c = 0; c < u_num_cascades; c++) {
            int spacing = 1 << (c + 1);
            int num_dirs = spacing;
            int offset_y = cascade_offset(c, screen_h);
            int height = cascade_height(c, screen_h);
            int px = pixel.x / spacing;
            int py = pixel.y / spacing;
            for (int dy = 0; dy <= 1; dy++) {
                for (int dx = 0; dx <= 1; dx++) {
                    int npx = px + dx;
                    int npy = py + dy;
                    for (int d = 0; d < num_dirs; d++) {
                        int tx = npx * spacing + d;
                        int ty = offset_y + npy;
                        if (tx >= screen.x || ty >= offset_y + height) continue;
                        vec4 data = imageLoad(u_cascade_atlas, ivec2(tx, ty));
                        if (length(data.rgb) > 0.001) {
                            imageStore(u_gi_output, pixel, vec4(data.rgb, 1.0));
                            return;
                        }
                    }
                }
            }
        }
        imageStore(u_gi_output, pixel, vec4(0.0, 0.0, 0.0, 1.0));
    }

    void main() {
        if (u_mode == MODE_POPULATE) {
            populate();
        } else if (u_mode == MODE_RECONSTRUCT) {
            reconstruct();
        } else if (u_mode == MODE_DEBUG_TEST) {
            debug_test();
        } else if (u_mode == 3) {
            debug_atlas();
        } else if (u_mode == 4) {
            debug_reconstruct();
        }
    }
    ENDGLSL
}
